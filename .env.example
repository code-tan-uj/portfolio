# ===========================================
# Portfolio Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!

# ===========================================
# Site Configuration
# ===========================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===========================================
# Hygraph CMS (Free: 100k API calls/month)
# Get credentials from: https://hygraph.com
# Project Settings > API Access
# ===========================================
HYGRAPH_ENDPOINT=https://api-xx-xxxx.hygraph.com/v2/xxxxx/master
HYGRAPH_TOKEN=

# ===========================================
# Supabase Database (Free: 500MB, 50k requests/month)
# Get credentials from: https://supabase.com
# Project Settings > API
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx...
SUPABASE_SERVICE_ROLE_KEY=eyJxxx...

# ===========================================
# Sentry Error Monitoring (Free: 5k errors/month)
# Get your DSN from: https://sentry.io
# Project Settings > Client Keys (DSN)
# ===========================================
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ===========================================
# Email Service - Resend (Free: 3000 emails/month)
# Get API key from: https://resend.com
# ===========================================
RESEND_API_KEY=re_xxxxx
EMAIL_FROM=noreply@yourdomain.com
NOTIFICATION_EMAIL=your@email.com

# ===========================================
# Email Service - Gmail SMTP (Alternative/Fallback)
# Use App Password, not regular password
# Generate at: https://myaccount.google.com/apppasswords
# ===========================================
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ===========================================
# Vercel Deployment (for GitHub Actions)
# Get from: https://vercel.com/account/tokens
# ===========================================
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# ===========================================
# Google Verification (optional)
# Get from: Google Search Console
# ===========================================
GOOGLE_SITE_VERIFICATION=
